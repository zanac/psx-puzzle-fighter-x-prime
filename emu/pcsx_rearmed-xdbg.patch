diff --git a/libpcsxcore/xdbg.c b/libpcsxcore/xdbg.c
new file mode 100644
index 0000000..8c2a84c
--- /dev/null
+++ b/libpcsxcore/xdbg.c
@@ -0,0 +1,79 @@
+#include <stdlib.h>
+#include <string.h>
+#include "xdbg.h"
+#include "r3000a.h"
+
+#define EXPORT __attribute__((visibility("default")))
+
+int xdbg_active;
+uint32_t xdbg_frame;
+xdbg_watch xdbg_watches[XDBG_MAX_WATCH];
+int xdbg_nwatch;
+uint32_t xdbg_bps[XDBG_MAX_BP];
+int xdbg_nbp;
+uint32_t *xdbg_cov;
+uint32_t xdbg_cov_lo, xdbg_cov_hi;
+
+static xdbg_entry logbuf[XDBG_LOG_MAX];
+static uint32_t lognum;
+
+static void push(uint32_t kind, uint32_t pc, uint32_t addr, uint32_t value, uint32_t size)
+{
+	xdbg_entry *e;
+	if (lognum >= XDBG_LOG_MAX)
+		return;
+	e = &logbuf[lognum++];
+	e->kind = kind; e->pc = pc; e->ra = psxRegs.GPR.n.ra;
+	e->addr = addr; e->value = value; e->size = size; e->frame = xdbg_frame;
+	memcpy(e->gpr, psxRegs.GPR.r, sizeof(e->gpr));
+}
+
+void xdbg_mem(int kind, uint32_t pc, uint32_t addr, uint32_t value, uint32_t size)
+{
+	int i;
+	uint32_t a = addr & 0x1fffff;
+	if ((addr & 0x0fffffff) >= 0x00800000) return;
+	for (i = 0; i < xdbg_nwatch; i++) {
+		xdbg_watch *w = &xdbg_watches[i];
+		if ((w->kind & kind) && a + size > w->lo && a < w->hi) {
+			push(kind, pc, addr, value, size);
+			return;
+		}
+	}
+}
+
+void xdbg_exec(uint32_t pc)
+{
+	int i;
+	if (xdbg_cov && pc >= xdbg_cov_lo && pc < xdbg_cov_hi)
+		xdbg_cov[(pc - xdbg_cov_lo) >> 2]++;
+	for (i = 0; i < xdbg_nbp; i++)
+		if (xdbg_bps[i] == pc) { push(3, pc, 0, 0, 0); return; }
+}
+
+/* ---- ctypes API ---- */
+EXPORT void xdbg_set_active(int on) { xdbg_active = on; }
+EXPORT void xdbg_clear(void) { xdbg_nwatch = 0; xdbg_nbp = 0; lognum = 0; }
+EXPORT void xdbg_clear_log(void) { lognum = 0; }
+EXPORT int xdbg_add_watch(uint32_t lo, uint32_t hi, uint32_t kind)
+{
+	if (xdbg_nwatch >= XDBG_MAX_WATCH) return -1;
+	xdbg_watches[xdbg_nwatch].lo = lo & 0x1fffff;
+	xdbg_watches[xdbg_nwatch].hi = ((hi - 1) & 0x1fffff) + 1;
+	xdbg_watches[xdbg_nwatch].kind = kind;
+	return xdbg_nwatch++;
+}
+EXPORT int xdbg_add_bp(uint32_t pc) { if (xdbg_nbp >= XDBG_MAX_BP) return -1; xdbg_bps[xdbg_nbp++] = pc; return 0; }
+EXPORT uint32_t xdbg_log_count(void) { return lognum; }
+EXPORT xdbg_entry *xdbg_log(void) { return logbuf; }
+EXPORT void xdbg_set_frame(uint32_t f) { xdbg_frame = f; }
+EXPORT uint32_t *xdbg_cov_enable(uint32_t lo, uint32_t hi)
+{
+	free(xdbg_cov);
+	xdbg_cov_lo = lo; xdbg_cov_hi = hi;
+	xdbg_cov = calloc((hi - lo) / 4, 4);
+	return xdbg_cov;
+}
+EXPORT void xdbg_cov_disable(void) { free(xdbg_cov); xdbg_cov = NULL; }
+EXPORT uint32_t *xdbg_regs(void) { return psxRegs.GPR.r; }
+EXPORT uint32_t xdbg_pc(void) { return psxRegs.pc; }
diff --git a/libpcsxcore/xdbg.h b/libpcsxcore/xdbg.h
new file mode 100644
index 0000000..72abba8
--- /dev/null
+++ b/libpcsxcore/xdbg.h
@@ -0,0 +1,33 @@
+/* Minimal research hooks (interpreter only): memory watchpoints,
+ * exec breakpoints that snapshot registers, and a PC coverage map. */
+#ifndef XDBG_H
+#define XDBG_H
+#include <stdint.h>
+
+#define XDBG_LOG_MAX 65536
+#define XDBG_MAX_WATCH 16
+#define XDBG_MAX_BP 32
+
+typedef struct {
+	uint32_t kind;      /* 1=write 2=read 3=exec */
+	uint32_t pc, ra, addr, value, size, frame;
+	uint32_t gpr[32];
+} xdbg_entry;
+
+typedef struct {
+	uint32_t lo, hi, kind; /* kind bitmask: 1 write, 2 read */
+} xdbg_watch;
+
+extern int xdbg_active;
+extern uint32_t xdbg_frame;
+extern xdbg_watch xdbg_watches[XDBG_MAX_WATCH];
+extern int xdbg_nwatch;
+extern uint32_t xdbg_bps[XDBG_MAX_BP];
+extern int xdbg_nbp;
+extern uint32_t *xdbg_cov;       /* hit counts for cov_lo..cov_hi (word granular) */
+extern uint32_t xdbg_cov_lo, xdbg_cov_hi;
+
+void xdbg_mem(int kind, uint32_t pc, uint32_t addr, uint32_t value, uint32_t size);
+void xdbg_exec(uint32_t pc);
+
+#endif
